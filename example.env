# Sample settings for npm and tsx commands run from this checkout.
# Copy to .env and fill in real values. .env.local overrides .env, and a variable
# already set in the shell overrides both.
#
# Release builds of the app ignore these files. Debug builds read them, then force
# their own database, Redis, API and artifact settings on top.

NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=http://localhost:8080
API_AUTH_MODE=single_user_token
API_BEARER_TOKEN=replace_me
API_CORS_ORIGINS=http://localhost:8080
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
# true, false, or the proxy's IP or CIDR. A hop count is refused.
API_TRUST_PROXY=false
API_DOCS_PUBLIC=true
# Production-only emergency override. Leave false unless you explicitly want
# bearer-less docs in production and have network controls in place.
API_DOCS_PUBLIC_PRODUCTION_OVERRIDE=false

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# scripts/dev-setup.sh starts Postgres and Redis on these ports from
# infrastructure/compose/docker-compose.local.yml. The app's own engine uses 55432
# for Postgres and 56379 for Redis.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/immoradar
DATABASE_POOL_MAX=4
DATABASE_STATEMENT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Redis / BullMQ
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=immoradar

# -----------------------------------------------------------------------------
# Artifacts
# -----------------------------------------------------------------------------
# Must be an absolute path. Empty means artifacts under IMMORADAR_RUNTIME_HOME, or
# ~/Library/Application Support/ImmoRadar/runtime/artifacts for commands run here.
ARTIFACTS_DIR=

# -----------------------------------------------------------------------------
# Playwright / browser runtime
# -----------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT_BROWSER_IDLE_CLOSE_MS=60000
PLAYWRIGHT_BROWSER_RECYCLE_AFTER_CONTEXTS=200
PLAYWRIGHT_CAPTURE_SCREENSHOT_ON_FAILURE=true
PLAYWRIGHT_CAPTURE_HTML_ON_FAILURE=true
PLAYWRIGHT_CAPTURE_HAR_ON_FAILURE=false
SCRAPER_BROWSER_RUNTIME=playwright
SCRAPER_PATCHRIGHT_SOURCES=

# -----------------------------------------------------------------------------
# Scraper limits
# -----------------------------------------------------------------------------
SCRAPER_MIN_CRAWL_INTERVAL_MINUTES=180
SCRAPER_MAX_PAGES_PER_RUN=60
SCRAPER_DETAIL_BUDGET_PER_RUN=40
SCRAPER_DETAIL_REFRESH_DAYS=30
SCRAPER_ARTIFACT_RETENTION_DAYS=7
CANARY_WORKER_ENABLED=false

# -----------------------------------------------------------------------------
# Documents / outbound download policy
# -----------------------------------------------------------------------------
DOCUMENT_DOWNLOAD_TIMEOUT_MS=20000
DOCUMENT_MAX_BYTES=10000000

# -----------------------------------------------------------------------------
# Scheduler
# -----------------------------------------------------------------------------
IMMORADAR_RUNTIME_BOOT_MODE=active
SCHEDULER_ENABLED=true
# Days without a sighting before an active listing's page gets rechecked.
STALE_THRESHOLD_DAYS=7
ZOMBIE_RUN_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------------
# Alerts
# -----------------------------------------------------------------------------
ALERTS_EMAIL_ENABLED=false
ALERTS_FROM_EMAIL=alerts@example.com
ALERTS_SMTP_HOST=localhost
ALERTS_SMTP_PORT=1025
ALERTS_SMTP_SECURE=false
ALERTS_SMTP_USER=
ALERTS_SMTP_PASSWORD=
ALERTS_WEBHOOK_ENABLED=false
ALERTS_PUSH_ENABLED=false
OPERATOR_USER_ID=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false

# -----------------------------------------------------------------------------
# Outreach
# -----------------------------------------------------------------------------
OUTREACH_ENABLED=false
OUTREACH_FROM_NAME=ImmoRadar
OUTREACH_POLL_INTERVAL_SECONDS=60
OUTREACH_INITIAL_LOOKBACK_DAYS=7
OUTREACH_FOLLOWUP_DELAY_HOURS=72
OUTREACH_MAX_AUTO_FOLLOWUPS=1
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_PORT=993
OUTREACH_IMAP_SECURE=true
OUTREACH_IMAP_USER=
OUTREACH_IMAP_PASSWORD=
OUTREACH_IMAP_MAILBOX=INBOX
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_SECURE=false
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Copilot
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COPILOT_DEFAULT_PROVIDER=anthropic
COPILOT_MODEL=
COPILOT_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=false
METRICS_TOKEN=replace_with_separate_metrics_token

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
FEATURE_GEOCODING_ENABLED=true
FEATURE_DOCUMENTS_ENABLED=false
